[Unit]
Description=GitHub Self-Hosted Runner with Docker CLI for {repo_name}
After=network-online.target podman.socket
Requires=podman.socket

[Container]
# CUSTOMIZATION: Image URL / Tag for the runner image containing docker-ce-cli built from Containerfile.docker
Image={container_image_url}
ContainerName=github-runner-docker-{repo_name}

# CUSTOMIZATION: Environment Variables
Environment=DOCKER_HOST=unix:///var/run/docker.sock
Environment=GITHUB_REPOSITORY=https://github.com/{owner}/{repo_name}
Environment=RUNNER_NAME=github-runner-docker-{repo_name}
Environment=RUNNER_LABELS={runner_labels}

# CUSTOMIZATION: Secret Token Injection (stored via `podman secret create github_runner_token_{repo_name} -`)
Secret=github_runner_token_{repo_name},type=env,target=RUNNER_TOKEN

# Execution Script
Exec=/entrypoint.sh

# CUSTOMIZATION: Volume Mounts
# Socket binding for non-root host Podman socket (or Docker socket) e.g., /run/user/1000/podman/podman.sock or %t/podman/podman.sock
Volume={host_docker_socket}:/var/run/docker.sock:z
# Host directory for workspace persistence
Volume={host_work_dir}:/home/runner/_work:U,z
# Named volume or host directory for configuration backup across container recreations
Volume=github-runner-{repo_name}-config:/home/runner/config:U,z

# CUSTOMIZATION: Optional Device Pass-Through (e.g. for hardware access if required)
# AddDevice=/dev/bus/usb:/dev/bus/usb

# Permissions & Security
GroupAdd=keep-groups
SecurityLabelDisable=true
RunInit=true
StopSignal=SIGINT
StopTimeout=30

[Service]
Restart=always

[Install]
WantedBy=default.target
