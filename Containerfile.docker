# Extended GitHub Self-Hosted Runner Container with Docker CLI
# CUSTOMIZATION: Change github-runner-base:latest to your base image tag or registry URL if needed
FROM github-runner-base:latest

# CUSTOMIZATION: Switch to root to install packages and configure dependencies
USER root

# Install Docker CLI dependencies and official Docker apt repository
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# CUSTOMIZATION: Revert back to non-root runner user (UID 1001)
USER runner

ENTRYPOINT ["/entrypoint.sh"]
